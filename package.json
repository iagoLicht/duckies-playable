{
  "name": "duckies-playable",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/pack.mjs",
    "assets": "node scripts/prepare-assets.mjs",
    "test": "tsc --noEmit -p tsconfig.test.json && vitest run",
    "tune": "node tests/tools/tune-levels.mjs",
    "calibrate": "node tests/tools/calibrate-clock.mjs",
    "shot": "node tests/shot.mjs",
    "responsive": "node tests/responsive.mjs",
    "perf": "node tests/perf.mjs",
    "flow": "node tests/rigged-flow.mjs"
  },
  "dependencies": {
    "@esotericsoftware/spine-pixi-v8": "~4.2.119",
    "pixi.js": "^8.16.0"
  },
  "devDependencies": {
    "playwright": "^1.60.0",
    "sharp": "^0.34.0",
    "subset-font": "^2.4.0",
    "typescript": "^5.5.0",
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.0.0",
    "vitest": "^3.2.7"
  }
}
